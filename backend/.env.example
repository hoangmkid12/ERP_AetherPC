# Mẫu cấu hình. Repo đã commit sẵn backend/.env (xem README) — chỉ dùng file này khi muốn trỏ sang DB/SMTP riêng.

# --- Bắt buộc ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aetherpc?schema=public
# Chuỗi ngẫu nhiên >= 32 ký tự (production từ chối khóa ngắn). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Khóa ký đường dẫn ảnh giao hàng trong email (để trống thì dùng JWT_SECRET)
LINK_SIGNING_SECRET=

# --- Email (chọn một kênh; để trống tất cả = không gửi email) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AetherPC

# --- Thanh toán chuyển khoản SePay ---
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
SEPAY_ACCOUNT_NAME=

# --- Tùy chọn ---
GEMINI_API_KEY=
GOONG_API_KEY=
OSRM_BASE_URL=
REDIS_URL=
DB_CONNECTION_LIMIT=
DB_POOL_TIMEOUT=
