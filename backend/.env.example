# Environment Configuration Template for ERP AetherPC Backend
PORT=5000
NODE_ENV=production

# Database URL (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kltn_erp?schema=public"

# JWT Secret Key for Authentication
JWT_SECRET="change_this_to_your_secure_random_secret_key"

# Set to "true" only once your deployment is actually served over HTTPS —
# the login cookie is marked Secure only when this is "true".
COOKIE_SECURE=false

# Email SMTP / Gmail App Password Configuration
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"
