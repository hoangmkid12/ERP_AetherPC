digraph UseCaseAetherPC {
  charset="UTF-8";
  graph [rankdir=LR, splines=ortho, overlap=false, nodesep=0.45, ranksep=2.2,
         fontname="Arial", bgcolor=white, compound=true,
         label="Xây Dựng Và Triển Khai Hệ Thống ERP Cho Doanh Nghiệp AetherPC",
         labelloc=t, fontsize=20, fontcolor="#111111"];
  node [fontname="Arial", fontsize=11, color="#333333"];
  edge [color="#555555", arrowsize=0.7, fontsize=9];

  // ============================================================
  // SYSTEM BOUNDARY — nhãn khung là TÊN HỆ THỐNG ("Hệ Thống ERP
  // AetherPC"), khác với label toàn graph ở trên là TÊN ĐỀ TÀI —
  // đúng theo góp ý: 2 nhãn khác vai trò không được dùng chung 1 chữ.
  // ============================================================
  subgraph cluster_system {
    label="Hệ Thống ERP AetherPC";
    fontsize=15;
    fontname="Arial";
    labelloc=t;
    style=solid;
    color="#333333";
    margin=30;
    node [shape=ellipse, style=filled, fillcolor=white, width=1.8];

    // ---------- CỘT 2 — USE CASE CỦA CÁC ACTOR CỘT 1 ----------
    // Khách Vãng Lai (3 — thêm "Tự Cấu Hình & Build PC": tính năng thật, xem
    // frontend/src/pages/Storefront/PCBuilder.jsx, route công khai App.jsx
    // "pc-builder" không có allowedRoles, addToCart gắn tag pc_build_bundle.
    // Chỉ nối với Khách Vãng Lai — Khách Hàng kế thừa qua generalization a2->a1,
    // không vẽ thêm association trùng, đúng nguyên tắc đã áp dụng cho uc_xemsp).
    uc_xemsp    [label="Xem Và Tìm\nSản Phẩm"];
    uc_dangky   [label="Đăng Ký\nTài Khoản"];
    uc_buildpc  [label="Tự Cấu Hình\nMáy Tính"];
    // Khách Hàng (8 — thêm "Chọn PT & Xác Nhận Thanh Toán": order.controller.js
    // dòng ~136 rẽ nhánh initialStatus=WAITING_PAYMENT khi paymentMethod là
    // BANK_TRANSFER/ONLINE_GATEWAY — có thật trong code, nhưng KHÔNG có cổng
    // thanh toán bên thứ 3 (VNPAY...) thật nào được tích hợp, chỉ là 1 field +
    // cờ isPaid do client tự báo — nên KHÔNG vẽ actor «system» Cổng Thanh Toán,
    // chỉ là 1 UC mở rộng của Đặt Hàng do chính Khách Hàng thực hiện.)
    uc_dathang  [label="Đặt Hàng"];
    // Đổi tên từ "Sửa / Hủy Đơn Hàng": order.routes.js dòng 32 — CUSTOMER
    // KHÔNG có trong danh sách role được phép PATCH /:id/status, tức khách
    // hàng không tự hủy đơn được. Route CUSTOMER duy nhất là PATCH /:id/details
    // (updateOrderDetails, order.controller.js dòng ~1319-1363) chỉ cho sửa
    // địa chỉ/ghi chú, và chỉ khi đơn đang PENDING — không có thao tác hủy.
    uc_suahuy   [label="Sửa Thông Tin Đơn\nHàng Chờ Xác Nhận"];
    uc_thanhtoan[label="Chọn Phương Thức\nThanh Toán"];
    uc_theodoi  [label="Theo Dõi\nĐơn Hàng"];
    uc_hoso     [label="Quản Lý Hồ Sơ\nVà Sổ Địa Chỉ"];
    uc_danhgia  [label="Đánh Giá\nSản Phẩm"];
    uc_khieunai [label="Gửi Khiếu Nại Và\nYêu Cầu Đổi Trả"];
    uc_chatkh   [label="Chat Hỗ Trợ\nTrực Tuyến"];
    // Nhân Viên CSKH (2)
    uc_chat      [label="Trả Lời Chat\nTrực Tuyến"];
    uc_xlkhieunai[label="Xử Lý\nKhiếu Nại"];
    // Nhà Cung Cấp (2 — đã gộp "Xem Đơn Mua Hàng Của Mình" vào 2 UC
    // dưới vì đó chỉ là thao tác xem trước khi phản hồi/xác nhận,
    // không phải mục tiêu nghiệp vụ riêng — sửa theo góp ý mục 4)
    uc_phanhoi  [label="Phản Hồi Yêu\nCầu Báo Giá"];
    uc_xacnhanpo[label="Xác Nhận\nĐơn Mua Hàng"];
    // Nhân Viên Bán Hàng (2)
    uc_pos       [label="Bán Hàng\nTại Quầy"];
    uc_xldonhang [label="Xử Lý Và Cập\nNhật Đơn Hàng"];
    // Quản Lý Bán Hàng (1)
    uc_duyethuy  [label="Duyệt Hủy\nĐơn Hàng"];
    // Nhân Viên Mua Hàng (3) — uc_taopo đổi tên từ "Tạo Đơn Mua Hàng (PO)":
    // purchase.controller.js dòng ~400-408 quy định chuyển trạng thái
    // QUOTED -> PO (phát hành PO chính thức) CHỈ CEO/ADMIN được làm ("Chỉ CEO
    // (Ban Giám Đốc) mới có quyền duyệt báo giá thành PO chính thức") — Mua
    // Hàng không tự tạo PO, chỉ chốt bảng so sánh báo giá rồi trình CEO duyệt.
    uc_qlncc     [label="Quản Lý Và Đánh\nGiá Nhà Cung Cấp"];
    uc_rfq       [label="Lập Yêu Cầu\nBáo Giá"];
    uc_sosanh    [label="So Sánh\nBáo Giá"];
    uc_taopo     [label="Trình Duyệt\nĐơn Mua Hàng"];
    // Nhân Viên QC (2)
    uc_qa        [label="Kiểm Tra Chất\nLượng Hàng Nhập"];
    uc_qctra     [label="Thẩm Định\nHàng Hoàn Trả"];

    { rank=same;
      uc_xemsp; uc_dangky; uc_buildpc;
      uc_dathang; uc_suahuy; uc_thanhtoan; uc_theodoi; uc_hoso; uc_danhgia; uc_khieunai; uc_chatkh;
      uc_chat; uc_xlkhieunai;
      uc_phanhoi; uc_xacnhanpo;
      uc_pos; uc_xldonhang;
      uc_duyethuy;
      uc_qlncc; uc_rfq; uc_sosanh; uc_taopo;
      uc_qa; uc_qctra;
    }
    uc_xemsp -> uc_dangky -> uc_buildpc
      -> uc_dathang -> uc_suahuy -> uc_thanhtoan -> uc_theodoi -> uc_hoso -> uc_danhgia -> uc_khieunai -> uc_chatkh
      -> uc_chat -> uc_xlkhieunai
      -> uc_phanhoi -> uc_xacnhanpo
      -> uc_pos -> uc_xldonhang
      -> uc_duyethuy
      -> uc_qlncc -> uc_rfq -> uc_sosanh -> uc_taopo
      -> uc_qa -> uc_qctra [style=invis];

    // ---------- CỘT 3 — USE CASE DÙNG CHUNG ----------
    // Đã BỎ "Đăng Nhập Hệ Thống" khỏi sơ đồ (góp ý mục 2): đăng nhập là
    // precondition của gần như mọi use case, không phải bước con bên
    // trong 1 luồng nghiệp vụ cụ thể — đúng chuẩn UML phải ghi ở phần
    // Precondition của bảng đặc tả use case, không vẽ <<include>>.
    // Chỉ còn 1 use case dùng chung thật sự là sub-flow bắt buộc của
    // nhiều actor khác nhau: kiểm tra/trừ tồn kho.
    uc_tonkho   [label="Kiểm Tra Và Cập\nNhật Tồn Kho"];

    // 3 use case của actor tổng quát «Nhân Viên» (a18, xem GENERALIZATION
    // bên dưới) — KHÁC với uc_tonkho ở trên: đây không phải sub-flow
    // <<include>> của actor khác, mà là nghiệp vụ tự phục vụ actor
    // "Nhân Viên" trực tiếp thực hiện, được MỌI vai trò nhân viên nội bộ kế
    // thừa qua generalization. Có bằng chứng route/trang thật, mở cho ĐỦ 13
    // vai trò nhân viên (không riêng ai): GET/POST /hr/leaves (hr.routes.js
    // dòng 22/34, authMiddleware liệt kê đủ CEO/ADMIN/HR/SALES/SALES_MANAGER/
    // WAREHOUSE/WAREHOUSE_MANAGER/ASSEMBLY/ACCOUNTANT/PURCHASING/CSKH/
    // DELIVERY/QC_ROLES) và GET /hr/payrolls/mine (dòng 303, cùng danh sách
    // vai trò y hệt — route "MyPayroll" tự tra cứu phiếu lương của chính
    // mình, tách biệt GET /hr/payrolls chỉ HR/CEO/Kế Toán xem toàn công ty).
    // Không gộp vào uc_nghiphep/uc_luong hiện có vì đó là 2 use case KHÁC
    // actor: uc_nghiphep là HR duyệt/quản lý đơn của người khác, uc_luong là
    // Kế Toán giải ngân lương toàn công ty — còn đây là tự thao tác cho
    // chính mình, chủ thể thực hiện khác nhau dù cùng phân hệ HR.
    uc_xinnghi  [label="Xin Nghỉ Phép\n(Đơn Của Tôi)"];
    uc_luongtoi [label="Tra Cứu Bảng\nLương Của Tôi"];
    // uc_xemtongquan là use case TRỪU TƯỢNG (abstract) — mỗi actor con hiện
    // thực hoá bằng đúng trang "Tổng Quan" riêng của phân hệ mình khi đăng
    // nhập (có thật: Warehouse.jsx, QualityControl.jsx, Delivery/index.jsx,
    // Accountant.jsx, HRManager.jsx, Assembly.jsx, SalesPOS.jsx,
    // CustomerService.jsx, Purchasing.jsx, SystemAdmin.jsx, Dashboard.jsx
    // đều có tab/trang "Tổng Quan" riêng). Generalization ở actor kéo theo
    // use case này cũng mang tính kế thừa — mỗi actor con override nội dung
    // cụ thể, giống nguyên tắc kế thừa trong OOP, không phải 12 trang giống
    // hệt nhau.
    uc_xemtongquan [label="Xem Tổng Quan\nCông Việc"];

    // Cầu nối rank vô hình cột 3 → cột 4: cạnh include thật duy nhất nối
    // 2 cụm này (uc_xuatkho -> uc_tonkho) bị đánh dấu constraint=false
    // (do ngược chiều rank cột 4→cột 3) nên cần 1 cạnh ẩn thay thế, nếu
    // không 2 cụm sẽ thành rời rạc và dot xếp sai rank (lỗi đã gặp).
    // weight=100 (mặc định 1): uc_tonkho dùng CHUNG rank với cả 21 use
    // case cột 4 (không phải 1 cột riêng), nên thuật toán giảm giao cắt
    // của dot có thể tự ý đẩy nó xuống cuối stack nếu chỉ dùng edge ẩn
    // trọng số thường — từng gặp lỗi này (nhãn «include» trôi lạc gần
    // Chấm Công/Nhà Cung Cấp do đường từ Đặt Hàng/POS phải kéo dài hết cỡ
    // xuống đáy). weight cao ép nó đứng ngay đầu stack, sát uc_grn.
    // uc_xinnghi/uc_luongtoi/uc_xemtongquan dùng chung nguyên tắc này (cùng
    // rank cột 4) để cả cụm "use case dùng chung" đứng liền nhau, không rời rạc.
    uc_tonkho -> uc_xinnghi -> uc_luongtoi -> uc_xemtongquan -> uc_grn [style=invis, weight=100];

    // ---------- CỘT 4 — USE CASE CỦA CÁC ACTOR CỘT 5 ----------
    // Nhân Viên Kho (1 — đã gộp "Xem Lịch Sử Điều Chuyển Kho" vào GRN:
    // gộp theo tiêu chí mục 4, vì xem lịch sử chỉ là 1 màn hình tra cứu
    // đi kèm nghiệp vụ nghiệm thu, không phải mục tiêu riêng của actor)
    uc_grn       [label="Nghiệm Thu\nHàng Nhập Kho"];
    // Quản Lý Kho (2 — uc_kiemke đã chuyển association sang Nhân Viên Kho ở
    // dưới, vì warehouse.routes.js dòng 31 (route /inventory/adjust) cho
    // phép CẢ WAREHOUSE lẫn WAREHOUSE_MANAGER, không phải quyền riêng của
    // Quản Lý — nhân viên gốc có sẵn thao tác này, Quản Lý kế thừa qua mũi
    // tên generalization a10->a9, không cần vẽ 2 association trùng nhau.
    // Giữ nguyên uc_xuatkho là 1 UC duy nhất (không tách "Xác Nhận Xuất Kho"
    // và "Phân Công Giao Hàng" thành 2 UC riêng): README/CLAUDE.md và
    // order.routes.js dòng 32 xác nhận đây là 1 hành động — bấm "Xác Nhận
    // Xuất Kho" mở ngay modal phân công shipper trong cùng 1 lượt thao tác,
    // dùng chung 1 API PATCH /:id/status — tách đôi sẽ sai với hệ thống thật.
    uc_xuatkho   [label="Xác Nhận Xuất Kho Và\nPhân Công Giao Hàng"];
    uc_danhmucsp [label="Quản Lý Danh\nMục Sản Phẩm"];
    // Nhân Viên Kho (2 — thêm "Kiểm Kê & Cân Bằng Tồn Kho", chuyển từ Quản
    // Lý Kho sang đây, xem giải thích ở trên).
    uc_kiemke    [label="Kiểm Kê Và Điều\nChỉnh Tồn Kho"];
    // Phiếu Yêu Cầu Mua Hàng (PurchaseRequest): Thủ Kho lập (POST
    // /warehouse/purchase-requests, WAREHOUSE_ROLES) — Quản Lý Kho duyệt/từ chối
    // (PATCH .../approve|reject, CHỈ WAREHOUSE_MANAGER/CEO/ADMIN; Phòng Mua Hàng
    // không còn quyền này). Mua Hàng chỉ thấy và lập RFQ từ phiếu đã duyệt.
    uc_lappr     [label="Lập Phiếu Đề Xuất\nMua Hàng"];
    uc_duyetpr   [label="Duyệt Phiếu Đề\nXuất Mua Hàng"];
    // Nhân Viên Lắp Ráp (2)
    uc_nhanlenh  [label="Nhận Lệnh Lắp\nRáp Máy Tính"];
    uc_tiendo    [label="Cập Nhật Tiến\nĐộ Lắp Ráp"];
    // Nhân Viên Giao Hàng (2)
    uc_giaohang  [label="Giao Hàng Và\nThu Tiền Mặt"];
    uc_thuhoi    [label="Thu Hồi Hàng Bảo\nHành Và Hoàn Trả"];
    // Nhân Viên Kế Toán (4)
    uc_socai     [label="Ghi Nhận\nPhiếu Thu Chi"];
    uc_ttncc     [label="Thanh Toán\nNhà Cung Cấp"];
    uc_hoantien  [label="Giải Ngân Hoàn\nTiền Khách Hàng"];
    uc_luong     [label="Giải Ngân\nLương Nhân Viên"];
    // Nhân Viên Nhân Sự (4)
    uc_hosonv    [label="Quản Lý Hồ Sơ\nNhân Viên"];
    uc_chamcong  [label="Chấm Công\nHàng Ngày"];
    uc_lapluong  [label="Lập Bảng\nLương"];
    uc_nghiphep  [label="Duyệt Đơn\nNghỉ Phép"];
    // Quản Trị Viên (2 — đã gộp "Xem Nhật Ký Kiểm Toán" vào use case
    // quản lý tài khoản, cùng tiêu chí gộp UC "Xem..." ở mục 4)
    uc_qltk      [label="Quản Trị Tài Khoản\nVà Phân Quyền"];
    uc_nhatky    [label="Xem Nhật Ký\nHệ Thống"];
    uc_backup    [label="Sao Lưu Và Phục\nHồi Dữ Liệu"];
    // Ban Giám Đốc (3)
    uc_duyetpo    [label="Duyệt Đơn\nMua Hàng"];
    uc_duyetluong [label="Duyệt Bảng Lương\nToàn Công Ty"];
    uc_dashboard  [label="Xem Báo Cáo\nTổng Thể"];

    { rank=same;
      uc_tonkho;
      uc_xinnghi; uc_luongtoi; uc_xemtongquan;
      uc_grn;
      uc_xuatkho; uc_kiemke; uc_danhmucsp; uc_lappr; uc_duyetpr;
      uc_nhanlenh; uc_tiendo;
      uc_giaohang; uc_thuhoi;
      uc_socai; uc_ttncc; uc_hoantien; uc_luong;
      uc_hosonv; uc_chamcong; uc_lapluong; uc_nghiphep;
      uc_qltk; uc_nhatky; uc_backup;
      uc_duyetpo; uc_duyetluong; uc_dashboard;
    }
    uc_grn
      -> uc_xuatkho -> uc_kiemke -> uc_lappr -> uc_danhmucsp -> uc_duyetpr
      -> uc_nhanlenh -> uc_tiendo
      -> uc_giaohang -> uc_thuhoi
      -> uc_socai -> uc_ttncc -> uc_hoantien -> uc_luong
      -> uc_hosonv -> uc_chamcong -> uc_lapluong -> uc_nghiphep
      -> uc_qltk -> uc_nhatky -> uc_backup
      -> uc_duyetpo -> uc_duyetluong -> uc_dashboard [style=invis];
  }

  // ============================================================
  // CỘT 1 — 8 ACTOR (trái, NẰM NGOÀI boundary) — người que UML
  // ============================================================
  node [shape=plaintext];
  a1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Khách Vãng Lai</TD></TR></TABLE>>];
  a2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Khách Hàng<BR/>(Thành Viên)</TD></TR></TABLE>>];
  a6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên CSKH</TD></TR></TABLE>>];
  a3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhà Cung Cấp</TD></TR></TABLE>>];
  a4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Bán Hàng</TD></TR></TABLE>>];
  a5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Quản Lý<BR/>Bán Hàng</TD></TR></TABLE>>];
  a7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Mua Hàng</TD></TR></TABLE>>];
  a8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên QC</TD></TR></TABLE>>];
  { rank=same; a1; a2; a6; a3; a4; a5; a7; a8; }
  // Thứ tự: CSKH (a6) ngay sau Khách Hàng (a2) để đường extend
  // "Xử Lý Khiếu Nại → Gửi Khiếu Nại" ngắn, không đi vòng cả sơ đồ.
  a1 -> a2 -> a6 -> a3 -> a4 -> a5 -> a7 -> a8 [style=invis];

  // ============================================================
  // CỘT 5 — 9 ACTOR (phải, NẰM NGOÀI boundary) — thêm actor hệ thống
  // ngoài «system» Hệ Thống Email (SMTP/nodemailer có thật, xem
  // backend/src/services/emailService.js) theo góp ý mục 8.
  // ============================================================
  a9  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên Kho</TD></TR></TABLE>>];
  a10 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Quản Lý Kho</TD></TR></TABLE>>];
  a11 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Lắp Ráp</TD></TR></TABLE>>];
  a12 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Giao Hàng</TD></TR></TABLE>>];
  a17 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>«system»<BR/>Hệ Thống Email</TD></TR></TABLE>>];
  a13 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Kế Toán</TD></TR></TABLE>>];
  a14 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên<BR/>Nhân Sự</TD></TR></TABLE>>];
  a15 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Quản Trị Viên</TD></TR></TABLE>>];
  a16 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Ban Giám Đốc</TD></TR></TABLE>>];
  // ============================================================
  // ACTOR TỔNG QUÁT (a18) — «Nhân Viên», actor cha chung cho toàn bộ
  // 13 vai trò nhân viên nội bộ. Khai báo TRƯỚC khi dùng trong rank=same
  // bên dưới (dot yêu cầu node tồn tại trước khi gán rank cùng node khác).
  // Xếp CÙNG RANK với cột 5 (không phải cột riêng): 2 use case của a18
  // (uc_xinnghi/uc_luongtoi) đã bị ép vào rank cột 4 (xem khai báo use
  // case), nên actor sở hữu chúng phải đứng đúng 1 rank sau đó — y hệt
  // logic uc_grn -> a9, uc_xuatkho -> a10... Xếp a18 rời khỏi rank này
  // (như thử ban đầu) khiến dot không còn đủ ràng buộc hợp lệ và đẩy cả
  // a18 lẫn note_nhanvien lên tận đầu sơ đồ — lỗi đã gặp và sửa ở đây.
  a18 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="actor_icon.png"/></TD></TR><TR><TD>Nhân Viên</TD></TR></TABLE>>];
  { rank=same; a9; a10; a11; a12; a17; a13; a14; a15; a16; a18; }
  // a17 (Hệ Thống Email) đặt cạnh Giao Hàng vì email trạng thái đơn
  // hàng gắn với bước xuất kho/giao hàng — không đi vòng xa. a18 đặt
  // CUỐI chuỗi (sau a16) vì nó chỉ liên quan use case ở cuối cột 4
  // (uc_xinnghi/uc_luongtoi đứng sau uc_tonkho, sát uc_grn).
  a9 -> a10 -> a11 -> a12 -> a17 -> a13 -> a14 -> a15 -> a16 -> a18 [style=invis];

  // ============================================================
  // ASSOCIATION — Actor cột 1 ↔ Use case cột 2 (liền kề)
  // ============================================================
  edge [style=solid, dir=none, arrowhead=none, label=""];
  a1 -> uc_xemsp;
  a1 -> uc_dangky;
  a1 -> uc_buildpc;
  a2 -> uc_dathang;
  a2 -> uc_suahuy;
  a2 -> uc_thanhtoan;
  a2 -> uc_theodoi;
  a2 -> uc_hoso;
  a2 -> uc_danhgia;
  a2 -> uc_khieunai;
  a2 -> uc_chatkh;
  a6 -> uc_chat;
  a6 -> uc_xlkhieunai;
  a3 -> uc_phanhoi;
  a3 -> uc_xacnhanpo;
  a4 -> uc_pos;
  a4 -> uc_xldonhang;
  a5 -> uc_duyethuy;
  a7 -> uc_qlncc;
  a7 -> uc_rfq;
  a7 -> uc_sosanh;
  a7 -> uc_taopo;
  a8 -> uc_qa;
  a8 -> uc_qctra;
  // ============================================================
  // ASSOCIATION — Use case cột 4 ↔ Actor cột 5 (liền kề)
  // Chiều edge phải là uc -> actor (không phải actor -> uc) để dot xếp
  // đúng thứ tự rank trái→phải; arrowhead=none nên không hiện mũi tên,
  // đúng ý nghĩa Association 2 chiều dù chiều edge kỹ thuật là 1 chiều.
  // ============================================================
  uc_grn -> a9; uc_kiemke -> a9; uc_lappr -> a9;
  uc_xuatkho -> a10; uc_danhmucsp -> a10; uc_duyetpr -> a10;
  uc_nhanlenh -> a11; uc_tiendo -> a11;
  uc_giaohang -> a12; uc_thuhoi -> a12;
  uc_socai -> a13; uc_ttncc -> a13; uc_hoantien -> a13; uc_luong -> a13;
  uc_hosonv -> a14; uc_chamcong -> a14; uc_lapluong -> a14; uc_nghiphep -> a14;
  uc_qltk -> a15; uc_nhatky -> a15; uc_backup -> a15;
  uc_duyetpo -> a16; uc_duyetluong -> a16; uc_dashboard -> a16;
  // Nhân Viên (a18): CHIỀU EDGE uc -> actor giống các actor cột 5 khác ở
  // trên (không phải actor -> uc như thử ban đầu) — bắt buộc để a18 nằm
  // đúng rank ngay sau cột 4 (nơi uc_xinnghi/uc_luongtoi đang đứng), tránh
  // lỗi layout đã gặp: a18 và note_nhanvien bị đẩy lên tận đầu sơ đồ do
  // không còn ràng buộc rank hợp lệ.
  uc_xinnghi -> a18; uc_luongtoi -> a18; uc_xemtongquan -> a18;
  // Hệ Thống Email có 3 hàm thật trong emailService.js: sendOrderConfirmationEmail
  // (order.controller.js dòng ~280, trong createOrder — backing uc_dathang),
  // sendWelcomeEmail (auth.controller.js, trong registerCustomer — backing
  // uc_dangky), sendOrderStatusUpdateEmail (order.controller.js dòng
  // 697-714, đặt CUỐI hàm updateOrderStatus, bắn KHÔNG ĐIỀU KIỆN cho MỌI
  // lần đổi trạng thái, không phân biệt status là gì). updateOrderStatus
  // là handler DUY NHẤT backing route PATCH /:id/status (order.routes.js
  // dòng 32), được 4 use case dùng CHUNG một đoạn code này: uc_xldonhang
  // (Sales cập nhật đơn), uc_duyethuy (Sales Manager hủy đơn, status=
  // CANCELLED), uc_xuatkho (Warehouse Manager xác nhận xuất kho), uc_giaohang
  // (Delivery giao hàng) — cả 4 đều kích hoạt email, không chỉ 2.
  // KHÔNG vẽ association uc_dangky/uc_dathang/uc_xldonhang/uc_duyethuy -> a17
  // trên sơ đồ TỔNG QUÁT này: cả 4 use case đều ở tận cột 2, cách xa a17 ở
  // cột 5 — vẽ ra sẽ tạo đường dài cắt ngang toàn bộ cột Kế Toán/Nhân Sự/
  // Admin/CEO ở giữa sơ đồ (đã thử, path SVG dài ~570-750px xuyên qua nhiều
  // use case không liên quan), đổi lấy rất ít giá trị so với chi phí thẩm
  // mỹ — đúng nguyên tắc đã áp dụng cho uc_dangky/uc_dathang. 4 điểm kích
  // hoạt này (uc_dangky, uc_dathang, uc_xldonhang, uc_duyethuy đều gọi
  // chung 1 trong 2 hàm sendWelcomeEmail/sendOrderStatusUpdateEmail) ghi
  // trong Bảng Đặc Tả Use Case (cột Post-condition) là đủ. Riêng
  // uc_xldonhang/uc_duyethuy ĐÃ được vẽ association thật (không phải chỉ
  // ghi chú) ở sơ đồ vệ tinh usecase_banhang_cskh.dot, nơi actor a4/a5 nằm
  // NGAY CẠNH a17 (thứ tự cột phải: a6->a4->a5->a12->a17) nên đường vẽ ra
  // ngắn, sạch, không cắt ngang sơ đồ — nên dùng sơ đồ vệ tinh đó làm bằng
  // chứng trực quan, sơ đồ tổng quát chỉ cần đúng ở tầng ghi chú.
  uc_xuatkho -> a17 [style=dashed];
  uc_giaohang -> a17 [style=dashed];

  // ============================================================
  // GENERALIZATION — 3 quan hệ vẽ tường minh (tam giác rỗng LUÔN nằm ở
  // đầu actor TỔNG QUÁT/cha, mũi tên hướng TỪ actor cụ thể/con ĐẾN actor
  // tổng quát — đã sửa lỗi chiều mũi tên (mục 5): trước đây dùng dir=back
  // + arrowtail khiến tam giác rơi vào đầu Khách Hàng thay vì Khách Vãng
  // Lai. Cách đúng: dir=forward (mặc định) + arrowhead=empty, vì head của
  // cạnh actor_con -> actor_cha CHÍNH LÀ actor cha) + 1 quan hệ generalization
  // thứ 4 (Nhân Viên) ghi bằng NOTE thay vì vẽ 11 mũi tên riêng — xem giải
  // thích ở khai báo note_nhanvien bên dưới.
  // ============================================================
  a2  -> a1 [arrowhead=empty, style=solid, constraint=false, weight=0];
  // Quản Lý Kho làm được mọi việc Nhân Viên Kho làm (toàn bộ route
  // warehouse.routes.js cho phép cả 2 role WAREHOUSE/WAREHOUSE_MANAGER)
  // cộng thêm quyền riêng (duyệt xuất kho, quản lý danh mục SP) — đủ
  // điều kiện generalization thật, không chỉ là 2 actor cùng phòng ban.
  a10 -> a9 [arrowhead=empty, style=solid, constraint=false, weight=0];
  // Tương tự: Quản Lý Bán Hàng làm được mọi việc Nhân Viên Bán Hàng
  // làm (POS, xử lý đơn) cộng thêm quyền duyệt hủy đơn riêng.
  a5  -> a4 [arrowhead=empty, style=solid, constraint=false, weight=0];

  // ---- KE THUA VE Nhan Vien (a18) ----
  // Da thu ve du 11 mui ten tam giac rong tu 11 vai tro noi bo ve a18
  // (a4, a6, a7, a8 o cot actor TRAI + a9, a11..a16 o cot actor PHAI).
  // Ket qua: dot phai keo 11 duong xuyen ngang toan bo so do, thuat toan
  // giam giao cat bi pha vo, 2 cot use case bi dun vao lam 1 va khung
  // ranh gioi he thong khong con bao dung cot 4 (da render kiem chung).
  // Giai phap: giu so do tong quat sach, va tach rieng QUAN HE KE THUA
  // ACTOR thanh mot hinh phu doc lap — file usecase_actor_hierarchy.dot —
  // noi ca 14 quan he generalization duoc ve TUONG MINH bang tam giac
  // rong dung chuan UML. Note ben duoi tro nguoi doc sang hinh phu do.

  // ---- NOTE 1: giai thich quan he ke thua actor ----
  note_nhanvien [shape=note, style=filled, fillcolor="#fffde7", color="#999999",
    fontsize=9, fontname="Arial", margin=0.15,
    label="KẾ THỪA ACTOR\l\lNhân Viên là actor cha của 11 vai trò nội bộ, nên vai trò\lnào cũng dùng được 3 chức năng chung ở trên.\lQuản Lý Bán Hàng kế thừa Nhân Viên Bán Hàng.\lQuản Lý Kho kế thừa Nhân Viên Kho.\lKhách Hàng Thành Viên kế thừa Khách Vãng Lai.\l"];
  a18 -> note_nhanvien [style=dashed, arrowhead=none, constraint=false, weight=0];

  // NOTE thứ 2 — giải thích trực quan NGAY TRÊN sơ đồ vì sao không có use
  // case "Đăng Nhập Hệ Thống": trước đây lý do này chỉ nằm trong comment mã
  // nguồn .dot (không ai đọc được khi chỉ xem file .svg/.png xuất ra), nay
  // ghi lại thành note gắn vào ranh giới hệ thống (lhead=cluster_system) để
  // người xem ảnh render cũng biết đây là quyết định có chủ đích, không
  // phải thiếu sót.
  // Rút ngắn tương tự note trên: bỏ thuật ngữ "Precondition"/"JWT"/«include»
  // (giữ tiếng Việt thuần cho phần hiển thị), bỏ câu giải thích "ghi ở cột
  // Precondition của Bảng Đặc Tả Use Case" (chi tiết học thuật này đã có ở
  // comment .dot phía trên khai báo use case cột 3, không cần lặp lại trên note).
  note_login [shape=note, style=filled, fillcolor="#fffde7", color="#999999",
    fontsize=9, fontname="Arial", margin=0.15,
    label="ĐIỀU KIỆN TIÊN QUYẾT\l\lMọi chức năng đều yêu cầu đã đăng nhập, trừ 3 chức\lnăng công khai của Khách Vãng Lai.\l"];
  note_login -> uc_xemsp [style=dashed, arrowhead=none, constraint=false, weight=0, lhead=cluster_system];

  // ============================================================
  // INCLUDE — nhóm 1: 3 quan hệ cùng trỏ về use case dùng chung duy
  // nhất "Kiểm Tra & Cập Nhật Tồn Kho" (đã bỏ Đăng Nhập, xem giải
  // trình ở khai báo use case cột 3 phía trên). Các nhóm include
  // khác bên dưới (chuỗi PO, chuỗi RMA, khiếu nại→CSKH, lắp ráp→xuất
  // kho) đều có bằng chứng code cụ thể kèm theo, xem chú thích từng
  // nhóm — không phải suy đoán chủ quan.
  // ============================================================
  edge [style=dashed, dir=forward, arrowhead=vee, fontname="Arial", fontsize=9];
  // Nhãn «include» đặt bằng taillabel (sát use case gốc) thay vì xlabel: với
  // splines=ortho, dot đặt xlabel ở vị trí tuỳ ý, có khi trôi sang cạnh use case
  // không liên quan (đã gặp: nhãn nằm cạnh "Quản Lý Hồ Sơ Nhân Viên", "Sao Lưu").
  uc_dathang -> uc_tonkho [taillabel="«include»", labeldistance=4.5, labelangle=-25];
  uc_pos     -> uc_tonkho [taillabel="«include»", labeldistance=4.5, labelangle=-25];
  uc_xuatkho -> uc_tonkho [taillabel="«include»", labeldistance=4.5, labelangle=25, constraint=false];
  // Nghiem thu hang nhap: buoc cong tang ton kho nam trong CUNG 1 luot thao tac
  // cua Nhan Vien Kho (cung API tao phieu nhap) nen du dieu kien «include».
  uc_grn     -> uc_tonkho [taillabel="«include»", labeldistance=4.5, labelangle=25, constraint=false];

  // KHÔNG vẽ include/extend nối chuỗi PO (Trình Duyệt PO -> Duyệt PO ->
  // Xác Nhận PO), chuỗi RMA (Khiếu Nại -> Thu Hồi -> Thẩm Định -> Hoàn
  // Tiền), Khiếu Nại -> Xử Lý Khiếu Nại, hay Lắp Ráp -> Xuất Kho, dù cả 4
  // chuỗi này đều có bằng chứng phụ thuộc thật trong code (state machine
  // purchase.controller.js dòng ~365-408; createReturnRequest/pickup/
  // qc-inspect/refund trong order.controller.js & order.routes.js dòng
  // 48/56/65; complaint.routes.js; updateAssemblyJob dòng ~131-146).
  // Lý do: «include»/«extend» trong UML chỉ mô tả bước con LUÔN xảy ra
  // TRONG CÙNG 1 lượt thực thi của CÙNG 1 actor — không phải quan hệ giữa
  // 2 use case của 2 actor khác nhau, xảy ra ở 2 thời điểm khác nhau (VD:
  // CSKH xử lý khiếu nại sau đó, không phải "trong lúc" khách gửi khiếu
  // nại). Đây đúng là lỗi y hệt việc từng vẽ "Đăng Nhập" làm include mà
  // sơ đồ đã cố tình bỏ — dùng sai chỗ sẽ tự mâu thuẫn với chính nguyên
  // tắc đó. Các phụ thuộc này cần ghi ở cột Trigger/Post-condition của
  // Bảng Đặc Tả Use Case (Use Case Specification), KHÔNG vẽ thành mũi tên
  // trong sơ đồ — cũng là cách chuẩn UML xử lý workflow liên-actor.

  // ============================================================
  // EXTEND — mỗi quan hệ có 1 UC gốc + 1 UC mở rộng rõ ràng, không
  // dùng chung use case gốc với include (tránh mơ hồ include/extend
  // cùng 1 cặp — góp ý mục 3).
  // ============================================================
  uc_duyethuy   -> uc_xldonhang [xlabel="«extend»"];
  uc_danhgia    -> uc_theodoi   [xlabel="«extend»"];
  uc_thanhtoan  -> uc_dathang   [xlabel="«extend»"];
  uc_buildpc    -> uc_dathang   [xlabel="«extend»", constraint=false];
}
