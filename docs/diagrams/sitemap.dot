// Sơ đồ site map của hệ thống AetherPC ERP (Hình 5.x trong báo cáo).
digraph Sitemap {
  charset="UTF-8";
  graph [rankdir=LR, splines=ortho, nodesep=0.18, ranksep=0.55, fontname="Arial", bgcolor=white];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#334155", fontname="Arial", fontsize=11, margin="0.12,0.06"];
  edge [color="#64748b", arrowsize=0.6];

  root [label="AetherPC ERP", fillcolor="#1e3a8a", fontcolor="white", fontsize=13];

  store [label="Cửa hàng trực tuyến", fillcolor="#dbeafe"];
  login [label="Đăng nhập / Đăng ký", fillcolor="#dbeafe"];
  admin [label="Trang quản trị nghiệp vụ", fillcolor="#dcfce7"];
  supplier [label="Cổng nhà cung cấp", fillcolor="#fef3c7"];
  root -> {store login admin supplier};

  s1 [label="Trang chủ"]; s2 [label="Danh mục, chi tiết sản phẩm"]; s3 [label="Tự cấu hình máy tính"];
  s4 [label="Giỏ hàng, đặt hàng"]; s5 [label="Đơn hàng của tôi, theo dõi giao hàng"]; s6 [label="Khuyến mãi, tin tức"];
  s7 [label="Hồ sơ, sổ địa chỉ"];
  store -> {s1 s2 s3 s4 s5 s6 s7};

  a0 [label="Tổng quan Ban Giám đốc\n(báo cáo, trung tâm phê duyệt)"];
  a1 [label="Bán hàng\n(POS, đơn hàng, khách hàng, khuyến mãi)"];
  a2 [label="Mua hàng\n(đề xuất, báo giá, đơn mua hàng, NCC)"];
  a3 [label="Kiểm định chất lượng\n(hàng nhập, đổi trả)"];
  a4 [label="Kho\n(tồn kho, nhập, xuất, vị trí kệ)"];
  a5 [label="Lắp ráp\n(lệnh lắp ráp, kiểm thử)"];
  a6 [label="Giao hàng\n(chuyến giao, thu hồi, tiền thu hộ)"];
  a7 [label="Kế toán\n(sổ cái, thanh toán NCC, chi lương)"];
  a8 [label="Chăm sóc khách hàng\n(chat, khiếu nại, đổi trả)"];
  a9 [label="Nhân sự\n(hồ sơ, chấm công, bảng công,\nnghỉ phép, tính lương, cấu hình)"];
  a10 [label="Quản trị hệ thống\n(tài khoản, phân quyền, nhật ký, sao lưu)"];
  a11 [label="Cổng nhân viên\n(chấm công khuôn mặt, nghỉ phép,\nphiếu lương, hồ sơ, tài liệu)", fillcolor="#e0e7ff"];
  admin -> {a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11};

  p1 [label="Yêu cầu báo giá"]; p2 [label="Đơn mua hàng cần xác nhận"];
  supplier -> {p1 p2};
}
