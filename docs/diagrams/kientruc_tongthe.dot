// ============================================================================
// Sơ đồ kiến trúc tổng thể hệ thống AetherPC.
// Đối chiếu: docker-compose.yml (redis, backend, worker, frontend; CSDL
// PostgreSQL chạy trên Railway, không còn container db), frontend/vite.config.js
// (proxy /api và /ws), backend/src/server.js, services/emailService.js
// (Resend / Brevo / Gmail SMTP), frontend/src/utils/routingService.js
// (Goong, OSRM, Nominatim/OpenStreetMap).
// Luồng Backend -> Redis vẽ nét đứt: enqueueOrder chỉ được gọi từ
// backend/scripts/enqueue_demo.js, chưa gắn vào luồng tạo đơn thật.
// ============================================================================
digraph KienTrucTongThe {
  charset="UTF-8";
  newrank=true;
  graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.6, ranksep=0.9,
         fontname="Arial", bgcolor=white, compound=true,
         label="Sơ Đồ Kiến Trúc Tổng Thể Hệ Thống AetherPC",
         labelloc=t, fontsize=20, fontcolor="#111111"];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#333333",
        fontname="Arial", fontsize=11, margin="0.2,0.12"];
  edge [color="#333333", fontname="Arial", fontsize=9.5, arrowsize=0.8, penwidth=1.0];

  // ---------- Tầng người dùng ----------
  subgraph cluster_client {
    label="Tầng Người Dùng (Trình Duyệt)"; fontsize=13; fontname="Arial Bold"; style=rounded; color="#666666"; margin=16;
    u_kh  [label="Cửa Hàng Trực Tuyến\n(Khách Hàng)"];
    u_nv  [label="Trang Quản Trị ERP\n(Nhân Viên, Ban Giám Đốc)"];
    u_gh  [label="Ứng Dụng Giao Hàng\n(Nhân Viên Giao Hàng)"];
    u_ncc [label="Cổng Nhà Cung Cấp\n(Nhà Cung Cấp)"];
  }

  // ---------- Máy chủ ứng dụng (Docker Compose) ----------
  subgraph cluster_compose {
    label="Máy Chủ Ứng Dụng (Docker Compose)"; fontsize=13; fontname="Arial Bold"; style=dashed; color="#666666"; margin=20;

    subgraph cluster_fe {
      label="Giao Diện"; fontsize=11; fontname="Arial"; style=solid; color="#888888"; margin=12;
      frontend [label="Ứng Dụng Web React\n(Vite, cổng 3000)\nChuyển tiếp /api và /ws tới máy chủ API"];
    }

    subgraph cluster_be {
      label="Máy Chủ API"; fontsize=11; fontname="Arial"; style=solid; color="#888888"; margin=12;
      backend [label="Máy Chủ Express (cổng 5000)\n─────────────────────\nAPI REST /api/v1 + xác thực JWT, phân quyền\nKênh WebSocket /ws/cskh (chat CSKH, định vị giao hàng)\nBộ hẹn giờ tự duyệt đơn hàng\nTruy cập dữ liệu qua Prisma"];
    }

    subgraph cluster_worker {
      label="Tiến Trình Nền"; fontsize=11; fontname="Arial"; style=solid; color="#888888"; margin=12;
      worker [label="Bộ Xử Lý Hàng Đợi\nĐơn Hàng"];
    }

    subgraph cluster_redis {
      label="Bộ Nhớ Đệm"; fontsize=11; fontname="Arial"; style=solid; color="#888888"; margin=12;
      redis [label="Redis\n(hàng đợi đơn hàng,\ncổng 6379)", shape=cylinder, style=filled, fillcolor="#F5F5F5"];
    }
  }

  // ---------- Dịch vụ đám mây & bên ngoài ----------
  subgraph cluster_cloud {
    label="Dịch Vụ Đám Mây & Bên Ngoài"; fontsize=13; fontname="Arial Bold"; style=rounded; color="#666666"; margin=16;
    db    [label="Cơ Sở Dữ Liệu PostgreSQL\n(Railway)", shape=cylinder, style=filled, fillcolor="#F5F5F5"];
    email [label="Dịch Vụ Gửi Email\n(Resend / Brevo / Gmail SMTP)"];
    maps  [label="Dịch Vụ Bản Đồ & Chỉ Đường\n(Goong, OSRM, OpenStreetMap)"];
  }

  { rank=same; u_kh; u_nv; u_gh; u_ncc; }
  { rank=same; worker; redis; }

  u_kh  -> frontend;
  u_nv  -> frontend;
  u_gh  -> frontend;
  u_ncc -> frontend;
  frontend -> backend [label="Gọi API REST\n+ WebSocket"];
  backend  -> db      [label="Đọc / ghi dữ liệu"];
  worker   -> db      [label="Cập nhật đơn hàng"];
  redis    -> worker  [label=" Lấy đơn\n cần xử lý", dir=back];
  backend  -> redis   [label="Đẩy đơn vào hàng đợi\n(chưa sử dụng)", style=dashed, color="#888888"];
  backend  -> email   [label="Gửi email\nthông báo đơn hàng"];
  u_gh     -> maps    [label="Tải bản đồ,\ntìm đường giao hàng"];
}
