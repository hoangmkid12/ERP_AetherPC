// Sơ đồ quan hệ thực thể (ERD) - CSDL AetherPC. Sinh tự động, đối chiếu backend/prisma/schema.prisma.
digraph ERD_AetherPC {
  charset="UTF-8";
  newrank=true;
  graph [rankdir=TB, splines=ortho, overlap=false, nodesep=0.45, ranksep=0.9, fontname="Arial", bgcolor=white,
         label="Sơ Đồ Quan Hệ Thực Thể (ERD) - Cơ Sở Dữ Liệu Hệ Thống AetherPC", labelloc=t, fontsize=22];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [color="#333333", dir=both, arrowsize=0.9, penwidth=1.0, fontname="Arial", fontsize=9];
  subgraph cluster_0 {
    label="Nhóm Sản Phẩm"; fontsize=14; fontname="Arial Bold"; style=rounded; color="#555555"; margin=16;
    categories [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    brands [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>brands</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    products [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>products</B></TD></TR><TR><TD ALIGN="LEFT"><U>product_id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">category_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">brand_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">default_supplier_code</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">price</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">average_cost</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">stock_quantity</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    serial_numbers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>serial_numbers</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">serial</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
    label="Nhóm Bán Hàng"; fontsize=14; fontname="Arial Bold"; style=rounded; color="#555555"; margin=16;
    customers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT"><U>customer_id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">tier</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">loyalty_points</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    customer_addresses [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>customer_addresses</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">address_line</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">city</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">is_default</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    orders [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT"><U>order_id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">assigned_shipper_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">sold_by_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    order_items [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>order_items</B></TD></TR><TR><TD ALIGN="LEFT"><U>order_item_id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">price</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    order_status_history [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>order_status_history</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    order_payments [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>order_payments</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">method</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">settled_at</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    product_reviews [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>product_reviews</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">rating</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
  }
  subgraph cluster_2 {
    label="Nhóm Kho & Lắp Ráp"; fontsize=14; fontname="Arial Bold"; style=rounded; color="#555555"; margin=16;
    warehouses [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>warehouses</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    inventory [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>inventory</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">warehouse_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity_on_hand</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">reorder_point</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    stock_movements [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>stock_movements</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">from_warehouse_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">to_warehouse_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    purchase_requests [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>purchase_requests</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">pr_code</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    assembly_jobs [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>assembly_jobs</B></TD></TR><TR><TD ALIGN="LEFT"><U>job_code</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">checklist</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
  }
  subgraph cluster_3 {
    label="Nhóm Mua Hàng"; fontsize=14; fontname="Arial Bold"; style=rounded; color="#555555"; margin=16;
    suppliers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>suppliers</B></TD></TR><TR><TD ALIGN="LEFT"><U>code</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    purchase_orders [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>purchase_orders</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">supplier_code</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">source_rfq_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">po_number</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    purchase_order_items [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>purchase_order_items</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">po_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">unit_cost</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    purchase_order_status_history [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>purchase_order_status_history</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">po_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    goods_receipts [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>goods_receipts</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">po_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">received_warehouse_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">receipt_number</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    qc_inspections [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>qc_inspections</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">receipt_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">inspector_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">passed_quantity</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">defective_quantity</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    vendor_bills [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>vendor_bills</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">po_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">supplier_code</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">amount_total</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">amount_due</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
    vendor_payments [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>vendor_payments</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">bill_id</TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
  }
  subgraph cluster_4 {
    label="Nhóm Nhân Sự & Kế Toán"; fontsize=14; fontname="Arial Bold"; style=rounded; color="#555555"; margin=16;
    employees [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">employee_code</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">base_salary</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
