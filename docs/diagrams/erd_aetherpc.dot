    ledger_entries [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>ledger_entries</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="CENTER"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="CENTER"> </TD></TR><TR><TD ALIGN="LEFT">reference_id</TD><TD ALIGN="CENTER"> </TD></TR></TABLE>>];
