  legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white">
    <TR><TD COLSPAN="2" BGCOLOR="#EFEFEF"><B>Chú Giải</B></TD></TR>
    <TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Khoá chính (gạch chân)</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">Khoá ngoại</TD></TR>
    <TR><TD ALIGN="LEFT">── | ──&lt;</TD><TD ALIGN="LEFT">Một và chỉ một — không hoặc nhiều</TD></TR>
    <TR><TD ALIGN="LEFT">── o ──&lt;</TD><TD ALIGN="LEFT">Không hoặc một — không hoặc nhiều</TD></TR>
    <TR><TD ALIGN="LEFT">- - - &gt;</TD><TD ALIGN="LEFT">Tham chiếu logic (không có khoá ngoại)</TD></TR>
  </TABLE>>];
