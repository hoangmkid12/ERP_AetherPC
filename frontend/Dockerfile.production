FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# Copy nginx template (uses ${PORT} placeholder)
COPY nginx.production.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
# Railway sets PORT dynamically; default to 80 for local Docker
ENV PORT=80
EXPOSE 80
# envsubst replaces ${PORT} in the template and writes the final config,
# then starts nginx in the foreground
CMD ["/bin/sh", "-c", "envsubst '${PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
