# Environment Configuration Template for ERP AetherPC Frontend
# Copy to .env and adjust as needed.

# Only needed when running "npm run dev" OUTSIDE Docker. Vite's dev-server
# proxy (vite.config.js) forwards /api/v1/* to this address; it defaults to
# "http://backend:5000" (the Docker Compose service name), which does not
# resolve on a plain localhost dev machine.
VITE_API_PROXY_TARGET=http://localhost:5000

# Only needed if the frontend must call a backend that is NOT reachable at
# the same origin via the dev-server proxy or production reverse proxy
# (e.g. pointing a local build at a remote/staging API). Leave unset for
# normal local dev and for the Docker Compose deployment — services/api.js
# defaults to the same-origin relative path "/api/v1".
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Base URL of a self-hosted OSRM (routing) instance — see osrm/ folder for how
# to build and deploy one on Railway. Leave unset to fall back to the public
# OSRM demo server (router.project-osrm.org), which has no uptime/rate-limit
# guarantee and is fine for local dev but not recommended for production.
# VITE_OSRM_BASE_URL=https://your-osrm-service.up.railway.app

# Goong Maptiles Key (https://account.goong.io) — renders the actual Goong map
# background via goong-js. Sign up for a free account and copy the "Maptiles
# Key" (not the REST API Key below — the two are NOT interchangeable). Leave
# unset and the map falls back to plain OpenStreetMap raster tiles.
# VITE_GOONG_MAPTILES_KEY=your-goong-maptiles-key

# Goong REST API key used to geocode Vietnamese addresses (house number/street/
# ward, including post-2024 administrative merger names) far more accurately
# than Nominatim/OSM. Copy the "REST API Key" (not the Maptiles Key above).
# Leave unset and routingService.js automatically falls back to Nominatim.
# VITE_GOONG_API_KEY=your-goong-rest-api-key
