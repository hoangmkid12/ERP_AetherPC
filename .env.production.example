# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_DB=kltn_erp
POSTGRES_USER=kltn_app
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://kltn_app:CHANGE_TO_A_LONG_RANDOM_PASSWORD@db:5432/kltn_erp?schema=public
# User Postgres CHỈ-ĐỌC cho trợ lý AI (node prisma/setup-ai-readonly-role.js tự sinh)
# DATABASE_URL_AI_READONLY=postgresql://aether_ai_readonly:CHANGE_ME@db:5432/kltn_erp?schema=public
JWT_SECRET=CHANGE_TO_A_64_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=https://example.com
NODE_ENV=production

# Địa chỉ website — dùng tạo link "Xác nhận đổi mật khẩu" trong email quên mật khẩu.
FRONTEND_URL=https://example.com
# OAuth Client ID (Web application) cho nút "Đăng nhập với Google";
# thêm FRONTEND_URL vào "Authorized JavaScript origins" trên Google Cloud Console.
GOOGLE_CLIENT_ID=

# Keep this "false" until your domain is actually serving HTTPS. The login
# cookie is marked Secure only when this is "true" — if you flip it before
# TLS is live, browsers silently drop the cookie and NOBODY can log in.
COOKIE_SECURE=false

# Optional SMTP configuration for transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Thanh toán chuyển khoản VietQR qua SePay (https://my.sepay.vn)
# API Key bạn tự đặt ở SePay → Tích hợp Webhooks → Kiểu chứng thực "API Key".
# Webhook URL khai báo trên SePay: https://<tên-miền>/api/v1/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=CHANGE_TO_A_LONG_RANDOM_KEY
# Tài khoản ngân hàng đã liên kết với SePay (nơi khách chuyển tiền vào).
# Bỏ trống cả hai dòng thì dùng tài khoản "VietQR mặc định" trong phân hệ Kế toán.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=MB
SEPAY_ACCOUNT_NAME=
