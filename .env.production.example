# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_DB=kltn_erp
POSTGRES_USER=kltn_app
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://kltn_app:CHANGE_TO_A_LONG_RANDOM_PASSWORD@db:5432/kltn_erp?schema=public
JWT_SECRET=CHANGE_TO_A_64_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=https://example.com
NODE_ENV=production

# Keep this "false" until your domain is actually serving HTTPS. The login
# cookie is marked Secure only when this is "true" — if you flip it before
# TLS is live, browsers silently drop the cookie and NOBODY can log in.
COOKIE_SECURE=false

# Optional SMTP configuration for transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
